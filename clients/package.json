{
  "name": "@pers0na2dev/single-auth",
  "version": "0.1.0",
  "description": "Browser, React, Next.js, Vue, and Solid clients for the native single-auth Go server.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE.md",
    "NOTICE.md",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./next-js": {
      "types": "./dist/next-js/index.d.ts",
      "default": "./dist/next-js/index.js"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "default": "./dist/vue/index.js"
    },
    "./solid": {
      "types": "./dist/solid/index.d.ts",
      "default": "./dist/solid/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "next-js": ["dist/next-js/index.d.ts"],
      "react": ["dist/react/index.d.ts"],
      "solid": ["dist/solid/index.d.ts"],
      "vue": ["dist/vue/index.d.ts"]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "bun run lint && bun run typecheck && bun run test && bun run build && bun run package-smoke",
    "lint": "oxlint src test scripts",
    "package-smoke": "bun scripts/package-smoke.ts",
    "prepack": "bun run build",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@better-fetch/fetch": "1.3.1",
    "defu": "^6.1.5",
    "nanostores": "^1.1.1"
  },
  "peerDependencies": {
    "next": "^14.0.0 || ^15.0.0 || ^16.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "solid-js": "^1.0.0",
    "vue": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "next": { "optional": true },
    "react": { "optional": true },
    "react-dom": { "optional": true },
    "solid-js": { "optional": true },
    "vue": { "optional": true }
  },
  "devDependencies": {
    "@types/bun": "^1.3.9",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/react-test-renderer": "^19.1.0",
    "next": "16.3.0",
    "oxlint": "^1.77.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-test-renderer": "^19.2.0",
    "solid-js": "^1.9.11",
    "typescript": "^6.0.3",
    "vue": "^3.5.29"
  }
}
